# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_DB=stockai
POSTGRES_USER=stockai_user
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

# Redis
REDIS_HOST=localhost
REDIS_PASSWORD=change_me
REDIS_PORT=6379

# Ollama (embeddings locais — nomic-embed-text)
OLLAMA_BASE_URL=http://localhost:11434

# LLMs
GEMINI_API_KEY=change_me
GROQ_API_KEY=change_me

# Google OAuth2
GOOGLE_CLIENT_ID=change_me
GOOGLE_CLIENT_SECRET=change_me

# JWT — obrigatório, sem fallback. Mínimo 32 caracteres aleatórios.
JWT_SECRET=change_me_random_32_chars_minimum

# Frontend — origem permitida no CORS (lista separada por vírgula) e destino do redirect pós-OAuth2
CORS_ALLOWED_ORIGINS=http://localhost:4200
FRONTEND_BASE_URL=http://localhost:4200

# Hugging Face — sentimento via FinBERT-PT-BR (finbert_sentiment.py). Opcional: sem
# token, cai automaticamente pro léxico (analyze_sentiment.py). IMPORTANTE: só o Java
# carrega .env via Spring; exporte esta var no shell que sobe o sidecar Python também
# (ex.: `export HUGGINGFACE_TOKEN=hf_...` antes de `uvicorn sidecar_app:app`).
HUGGINGFACE_TOKEN=change_me

# Postgres MCP (Claude Code, .mcp.json) — SEMPRE a role stockai_mcp_readonly (ver
# infra/postgres-mcp-readonly-role.sql), NUNCA reusar credencial de stockai_user aqui.
# Uso local apenas — NUNCA apontar pra um banco de produção se um dia existir. Exportar
# esta var no shell antes de abrir o Claude Code (.mcp.json expande ${POSTGRES_MCP_URI}).
POSTGRES_MCP_URI=postgresql://stockai_mcp_readonly:change_me@localhost:5432/stockai
