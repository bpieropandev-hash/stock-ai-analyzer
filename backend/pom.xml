<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.0.6</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.stockai</groupId>
	<artifactId>stock-ai-analyzer-backend</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>stock-ai-analyzer-backend</name>
	<description>Stock AI Analyzer Backend</description>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<properties>
		<java.version>26</java.version>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-redis</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-websocket</artifactId>
		</dependency>

		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>
		<!-- LangChain4j: cliente Ollama — embeddings (nomic-embed-text) local -->
		<dependency>
			<groupId>dev.langchain4j</groupId>
			<artifactId>langchain4j-ollama</artifactId>
			<version>1.18.1</version>
		</dependency>
		<!-- LangChain4j: OpenAI-compatible client — usado para Groq como chat LLM -->
		<dependency>
			<groupId>dev.langchain4j</groupId>
			<artifactId>langchain4j-open-ai</artifactId>
			<version>1.18.1</version>
		</dependency>
		<!-- LangChain4j: pgvector tem ciclo de release independente do ollama -->
		<dependency>
			<groupId>dev.langchain4j</groupId>
			<artifactId>langchain4j-pgvector</artifactId>
			<version>1.18.1-beta28</version>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-oauth2-client</artifactId>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-api</artifactId>
			<version>0.12.6</version>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-impl</artifactId>
			<version>0.12.6</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-jackson</artifactId>
			<version>0.12.6</version>
			<scope>runtime</scope>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
			<plugin>
				<!-- Error Prone em modo relatório (WARN) — nunca rodado em ERROR ainda,
				     pra não quebrar o build numa codebase sem disciplina de null-safety
				     até agora. Ver coding-standards.md antes de promover pra ERROR.
				     NullAway 0.12.7 NÃO incluído: incompatibilidade real verificada —
				     precisa de error_prone_core recente o bastante pra entender os
				     internals do javac do Java 26 (2.39.0 não entende, ClassNotFoundException
				     em com.sun.tools.javac.code.Flags$Flag), mas nessa versão recente
				     (2.50.0) o NullAway quebra (ClassNotFoundException em
				     com.google.errorprone.predicates.type.DescendantOf — API interna do
				     Error Prone mudou depois do release do NullAway 0.12.7). Sem versão
				     de NullAway que funcione com Java 26 nesse momento. Revisitar quando
				     o NullAway lançar uma versão compatível com Error Prone 2.5x+. -->
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<!-- fork=false (padrão) — o processador de anotação roda na mesma JVM
					     do Maven, que precisa dos add-exports/add-opens no PRÓPRIO
					     lançamento (.mvn/jvm.config), não em compilerArgs (isso só afeta
					     javac, e add-opens não tem efeito nenhum em javac). -->
					<compilerArgs>
						<arg>-XDcompilePolicy=simple</arg>
						<arg>--should-stop=ifError=FLOW</arg>
						<arg>-Xplugin:ErrorProne -XepAllErrorsAsWarnings</arg>
					</compilerArgs>
					<annotationProcessorPaths>
						<path>
							<groupId>com.google.errorprone</groupId>
							<artifactId>error_prone_core</artifactId>
							<version>2.50.0</version>
						</path>
					</annotationProcessorPaths>
				</configuration>
			</plugin>
			<plugin>
				<!-- BLOQUEADO — verificado, não é erro de config: o ASM interno do
				     SpotBugs 4.9.3.0 não lê bytecode do Java 26 ainda
				     (IllegalArgumentException: Unsupported class file major version 70).
				     Plugin fica declarado mas inerte (sem <executions>, não roda no
				     build padrão) pra reativar assim que uma versão compatível sair.
				     Ver decisions.md. -->
				<groupId>com.github.spotbugs</groupId>
				<artifactId>spotbugs-maven-plugin</artifactId>
				<version>4.9.3.0</version>
			</plugin>
		</plugins>
	</build>

</project>
